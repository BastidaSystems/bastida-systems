# ============================================================================
# Bastida Systems — environment variables (reference only)
# ============================================================================
# The live site is a STATIC site (plain HTML/CSS/JS on GitHub Pages): there
# is no build step, so these variables cannot be injected at deploy time
# the way NEXT_PUBLIC_* vars work in Next.js/Vercel.
#
# For this repo the working equivalent is `site-config.js` — copy
# `site-config.example.js` to `site-config.js` and fill in the values there.
# The mapping below shows which site-config.js key each variable corresponds
# to, so that if the site ever moves to a build-based host (Netlify, Vercel,
# Cloudflare Pages), the same values can be provided as real env vars and
# injected into site-config.js at build time.
#
# RULES:
# - Public identifiers (GA4, GTM, reCAPTCHA *site* key, maps embed) may live
#   in site-config.js — they are visible in page source by design.
# - NEVER put secrets here or in any frontend file: reCAPTCHA *secret* key,
#   OAuth client secrets, Supabase service_role keys, API private keys.
#   Those live only on the server / in the secret store of the host.
# ============================================================================

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
# → site-config.js: gaMeasurementId
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager — Container ID (GTM-XXXXXXX)
# When set, GA4 loads through GTM only (no duplicated events).
# → site-config.js: gtmId
NEXT_PUBLIC_GTM_ID=

# Google Search Console — HTML tag verification `content` value.
# Preferred method for this site is DNS verification (see docs), in which
# case this stays empty.
# → site-config.js: googleSiteVerification
GOOGLE_SITE_VERIFICATION=

# Google Business Profile — public URLs (shown in footer/contact when set)
# → site-config.js: googleBusinessUrl / googleReviewsUrl / googleMapsUrl
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Google Maps — embed `src` URL for the Contact page map (lazy-loaded)
# → site-config.js: googleMapsEmbedUrl
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Booking — Google Calendar Appointment Scheduling link
# → site-config.js: bookingUrl
NEXT_PUBLIC_BOOKING_URL=

# Contact form — HTTPS endpoint that receives form POSTs (JSON).
# Empty = the form falls back to opening the visitor's email app.
# → site-config.js: contactFormEndpoint
CONTACT_FORM_ENDPOINT=

# Public contact channels (already displayed on the site)
# → site-config.js: contactEmail / contactPhone
CONTACT_EMAIL=bastidasystems@gmail.com
CONTACT_PHONE=+17026617149

# reCAPTCHA v3 — SITE key only (public). The SECRET key is server-only
# and must never appear in this repo.
# → site-config.js: recaptchaSiteKey
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
